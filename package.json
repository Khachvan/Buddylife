{
  "name": "buddylife",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:sites": "vinext build && node scripts/prepare-sites-worker.mjs",
    "start": "next start",
    "test": "node --test tests/*.test.ts",
    "check:fast": "pnpm test && pnpm content && eslint lib/qr-attribution.ts lib/request-security.ts lib/tracking.ts lib/content-posts.ts app/production-analytics.tsx app/meta-pixel-consent.tsx tests/critical-flows.test.ts tests/tracking.test.ts tests/content-posts.test.ts",
    "check:release": "pnpm check:fast && pnpm build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "verify": "pnpm check:release",
    "vercel:pull:local": "vercel pull --yes --environment=development",
    "vercel:env:local": "vercel env pull .env.local --environment=development --yes",
    "release:rollback": "vercel rollback",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate-database.mjs",
    "db:migrate:local": "node --env-file=.env.local scripts/migrate-database.mjs",
    "content": "node scripts/validate-content.ts",
    "post:new": "node scripts/new-post.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.33.0",
    "next": "16.3.6",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "prettier": "^3.9.6",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "^0.35.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vercel": "59.6.2",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
