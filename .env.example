# Copy this file to .env.local only when Vercel CLI pull is unavailable.
# Never commit real values. Keep Preview and Production values separate in Vercel.

# Neon connection string from Vercel. For local development without Neon you can use
# DATABASE_URL=pglite:.data/pglite (a file-based Postgres engine; see README.md).
DATABASE_URL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Long random secret used only to sign anonymous QR attribution cookies.
# Generate separately for Development, Preview, and Production.
QR_ATTRIBUTION_SECRET=
# Canonical host encoded into generated QR images and exports.
# Production: https://buddylife.am
# Preview: https://buddylife-qr-preview.vercel.app
QR_PUBLIC_BASE_URL=
# SHA-256 hashes of the backoffice login and password, plus a separate session-signing secret.
BACKOFFICE_USERNAME_SHA256=
BACKOFFICE_PASSWORD_SHA256=
BACKOFFICE_SESSION_SECRET=
# Public Meta Pixel identifier. Keep unset outside environments where measurement is intentionally enabled.
NEXT_PUBLIC_META_PIXEL_ID=
# Registration confirmation email through Resend (Vercel → Integrations → Resend provides the key).
# RESEND_FROM must use a domain verified in Resend, e.g. "BuddyLife <hello@buddylife.am>".
# Leave both empty to disable sending (local development, Preview).
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
# Where "Write to us" messages are forwarded (the owner's mailbox). Requires RESEND_* above.
CONTACT_NOTIFY_TO=
